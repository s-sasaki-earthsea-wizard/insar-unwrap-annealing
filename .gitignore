# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Secrets and local environment
.env
.env.*
*.pem

# Data and experiment outputs are never versioned.
